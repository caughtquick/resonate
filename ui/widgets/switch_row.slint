import { Theme } from "../theme.slint";

export component SettingSwitchRow inherits Rectangle {
    in property <string> icon_name: "settings";
    in property <string> title: "Setting Title";
    in property <string> description: "Short description of what this setting controls";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    background: touch.has_hover ? Theme.bg_card_hover : Theme.bg_card;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border;
    height: 60px;

    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            // Icon box with tinted background - centered vertically
            VerticalLayout {
                alignment: center;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: Theme.radius_sm;
                    background: root.checked ? Theme.icon_bg_amber : Theme.bg_input;
                    border-width: 1px;
                    border-color: root.checked ? Theme.accent : Theme.border;

                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 20px;
                        height: 20px;
                        image-fit: contain;
                        source: root.icon_name == "play-pause" ? @image-url("../../assets/icons/play-pause.svg") :
                                (root.icon_name == "message" ? @image-url("../../assets/icons/message.svg") :
                                (root.icon_name == "sensor" ? @image-url("../../assets/icons/sensor.svg") :
                                (root.icon_name == "earbud" ? @image-url("../../assets/icons/earbud-left.svg") :
                                @image-url("../../assets/icons/settings.svg"))));
                        colorize: root.checked ? Theme.accent : Theme.text_muted;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.title;
                    color: root.enabled ? Theme.text_primary : Theme.text_disabled;
                    font-size: 13px;
                    font-weight: 700;
                }

                Text {
                    text: root.description;
                    color: Theme.text_secondary;
                    font-size: 11px;
                }
            }
        }

        // Custom Gruvbox Toggle Switch
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 44px;
                height: 24px;
                border-radius: 12px;
                background: root.checked ? Theme.success : #3c3836;
                border-width: 1px;
                border-color: root.checked ? Theme.success : #504945;

                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }

                // Knob
                Rectangle {
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    y: 2px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: root.checked ? #1d2021 : #ebdbb2;

                    animate x { duration: 150ms; easing: ease-out; }
                    animate background { duration: 150ms; }
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}
