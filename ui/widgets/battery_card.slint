import { Theme } from "../theme.slint";

export component BatteryPod inherits Rectangle {
    in property <string> label: "Left Bud";
    in property <string> pod_type: "left"; // "left", "right", "case", "headphone"
    in property <int> percent: -1;
    in property <bool> charging: false;
    in property <string> placement: "unknown";

    background: Theme.bg_card;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border;
    min-width: 150px;
    height: 125px;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        alignment: space-between;

        // Header: icon & placement badge
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Image {
                    source: root.pod_type == "left" ? @image-url("../../assets/icons/earbud-left.svg") :
                            (root.pod_type == "right" ? @image-url("../../assets/icons/earbud-right.svg") :
                            (root.pod_type == "case" ? @image-url("../../assets/icons/case.svg") :
                            @image-url("../../assets/icons/headphone.svg")));
                    width: 16px;
                    height: 16px;
                    colorize: root.percent >= 0 ? Theme.text_primary : Theme.text_muted;
                    vertical-alignment: center;
                }

                Text {
                    text: root.label;
                    color: Theme.text_secondary;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }

            // Placement pill badge
            if root.placement != "unknown" && root.placement != "" : Rectangle {
                border-radius: Theme.radius_pill;
                background: root.placement == "in_ear" ? #10b98122 : (root.placement == "in_case" ? #f59e0b22 : #33415544);
                border-width: 1px;
                border-color: root.placement == "in_ear" ? #10b98166 : (root.placement == "in_case" ? #f59e0b66 : #64748b66);
                height: 20px;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;

                    Text {
                        text: root.placement == "in_ear" ? "In Ear" : (root.placement == "in_case" ? "In Case" : "Out of Ear");
                        color: root.placement == "in_ear" ? #34d399 : (root.placement == "in_case" ? #fbbf24 : #94a3b8);
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // Main Battery Number
        HorizontalLayout {
            spacing: 6px;
            alignment: start;

            Text {
                text: root.percent >= 0 ? "\{root.percent}%" : "--";
                color: root.percent >= 0 ? Theme.text_primary : Theme.text_disabled;
                font-size: 26px;
                font-weight: 700;
                vertical-alignment: center;
            }

            if root.charging : Image {
                source: @image-url("../../assets/icons/bolt.svg");
                width: 16px;
                height: 16px;
                colorize: Theme.success;
                vertical-alignment: center;
            }
        }

        // Progress bar
        Rectangle {
            height: 5px;
            background: Theme.bg_input;
            border-radius: Theme.radius_pill;

            Rectangle {
                x: 0;
                y: 0;
                height: parent.height;
                width: root.percent >= 0 ? parent.width * (root.percent / 100.0) : 0px;
                border-radius: Theme.radius_pill;
                background: root.charging ? Theme.success : (root.percent > 40 ? Theme.accent : (root.percent > 20 ? Theme.warning : Theme.danger));

                animate width { duration: 300ms; }
                animate background { duration: 200ms; }
            }
        }
    }
}
