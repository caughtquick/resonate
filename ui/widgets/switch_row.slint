import { Theme } from "../theme.slint";
import { Switch } from "std-widgets.slint";

export component SettingSwitchRow inherits Rectangle {
    in property <string> icon_name: "settings";
    in property <string> title: "Setting Title";
    in property <string> description: "Short description of what this setting controls";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    background: touch.has_hover ? Theme.bg_card_hover : Theme.bg_card;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border;
    height: 64px;

    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 14px;
            alignment: start;

            // Icon bubble
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: Theme.radius_sm;
                background: root.checked ? Theme.accent_subtle : Theme.bg_input;
                border-width: 1px;
                border-color: root.checked ? Theme.accent : Theme.border;

                Image {
                    source: root.icon_name == "play-pause" ? @image-url("../../assets/icons/play-pause.svg") :
                            (root.icon_name == "message" ? @image-url("../../assets/icons/message.svg") :
                            (root.icon_name == "sensor" ? @image-url("../../assets/icons/sensor.svg") :
                            (root.icon_name == "earbud" ? @image-url("../../assets/icons/earbud-left.svg") :
                            @image-url("../../assets/icons/settings.svg"))));
                    width: 16px;
                    height: 16px;
                    colorize: root.checked ? Theme.accent_hover : Theme.text_secondary;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;

                Text {
                    text: root.title;
                    color: root.enabled ? Theme.text_primary : Theme.text_disabled;
                    font-size: 13px;
                    font-weight: 600;
                }

                Text {
                    text: root.description;
                    color: Theme.text_secondary;
                    font-size: 11px;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Switch {
                checked <=> root.checked;
                enabled: root.enabled;
                toggled => {
                    root.toggled(self.checked);
                }
            }
        }
    }

    touch := TouchArea {
        clicked => {
            if (root.enabled) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}
