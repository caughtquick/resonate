import { Theme } from "../theme.slint";

export component BatteryPod inherits Rectangle {
    in property <string> label: "Left Bud";
    in property <string> pod_type: "left"; // "left", "right", "case", "headphone"
    in property <int> percent: -1;
    in property <bool> charging: false;
    in property <string> placement: "unknown";

    background: Theme.bg_card;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border;
    height: 76px;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        alignment: space-between;

        // Header: icon, label, percent, and placement badge
        HorizontalLayout {
            alignment: space-between;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                // Tinted icon container - centered vertically
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 38px;
                        height: 38px;
                        border-radius: Theme.radius_sm;
                        background: root.percent >= 0 ? Theme.accent_subtle : Theme.bg_input;
                        border-width: 1px;
                        border-color: root.percent >= 0 ? Theme.accent : Theme.border;

                        Image {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 22px;
                            height: 22px;
                            image-fit: contain;
                            source: root.pod_type == "left" ? @image-url("../../assets/icons/earbud-left.svg") :
                                    (root.pod_type == "right" ? @image-url("../../assets/icons/earbud-right.svg") :
                                    (root.pod_type == "case" ? @image-url("../../assets/icons/case.svg") :
                                    @image-url("../../assets/icons/headphone.svg")));
                            colorize: root.percent >= 0 ? Theme.accent : Theme.text_muted;
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.label;
                        color: Theme.text_primary;
                        font-size: 13px;
                        font-weight: 700;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            text: root.percent >= 0 ? ("" + root.percent + "%") : "--";
                            color: root.percent >= 0 ? Theme.accent : Theme.text_disabled;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        if root.charging : VerticalLayout {
                            alignment: center;

                            Image {
                                source: @image-url("../../assets/icons/bolt.svg");
                                width: 14px;
                                height: 14px;
                                image-fit: contain;
                                colorize: Theme.success;
                            }
                        }
                    }
                }
            }

            // Placement pill badge
            if root.placement != "unknown" && root.placement != "" : VerticalLayout {
                alignment: center;

                Rectangle {
                    border-radius: Theme.radius_pill;
                    background: root.placement == "in_ear" ? #b8bb2622 : (root.placement == "in_case" ? #fabd2f22 : #50494540);
                    border-width: 1px;
                    border-color: root.placement == "in_ear" ? #b8bb2666 : (root.placement == "in_case" ? #fabd2f66 : #50494588);
                    height: 22px;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: root.placement == "in_ear" ? "In Ear" : (root.placement == "in_case" ? "In Case" : "Out of Ear");
                            color: root.placement == "in_ear" ? Theme.success : (root.placement == "in_case" ? Theme.warning : Theme.text_secondary);
                            font-size: 10px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Progress bar
        Rectangle {
            height: 4px;
            background: Theme.bg_input;
            border-radius: 2px;

            if root.percent > 0 : Rectangle {
                x: 0;
                width: parent.width * Math.min(100, Math.max(0, root.percent)) / 100;
                height: parent.height;
                border-radius: 2px;
                background: root.percent > 20 ? Theme.success : Theme.danger;
            }
        }
    }
}
