import { Theme } from "../theme.slint";

export component AncModeCard inherits Rectangle {
    in property <string> mode_id: "off";
    in property <string> title: "Off";
    in property <string> description: "Passive isolation";
    in property <bool> is_active: false;
    callback clicked();

    background: is_active ? #302f2d : (touch.has_hover ? Theme.bg_card_hover : Theme.bg_card);
    border-radius: Theme.radius_md;
    border-width: is_active ? 1.5px : 1px;
    border-color: is_active ? Theme.accent : Theme.border;
    height: 64px;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        // Mode icon pill - centered vertically in the card
        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: Theme.radius_sm;
                background: root.is_active ? Theme.icon_bg_amber : Theme.bg_input;
                border-width: 1px;
                border-color: root.is_active ? Theme.accent : Theme.border;

                Image {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    image-fit: contain;
                    source: root.mode_id == "off" ? @image-url("../../assets/icons/anc-off.svg") :
                            (root.mode_id == "anc" ? @image-url("../../assets/icons/anc-on.svg") :
                            (root.mode_id == "ambient" ? @image-url("../../assets/icons/anc-transparency.svg") :
                            (root.mode_id == "adaptive" ? @image-url("../../assets/icons/anc-adaptive.svg") :
                            @image-url("../../assets/icons/anc-wind.svg"))));
                    colorize: root.is_active ? Theme.accent : Theme.text_muted;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: root.is_active ? Theme.accent : Theme.text_primary;
                font-size: 13px;
                font-weight: 700;
            }

            Text {
                text: root.description;
                color: Theme.text_secondary;
                font-size: 11px;
            }
        }
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}
