import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

export struct DeviceEntry {
    name: string,
    address: string,
    vendor: string,
    connected: bool,
    is_multipoint: bool,
}

export component MultipointPage inherits ScrollView {
    in property <[DeviceEntry]> devices: [];
    in property <bool> is_connected_bw: false;

    callback connect_device(string);
    callback disconnect_device(string);
    callback connect_multipoint(string);
    callback refresh_devices();

    VerticalLayout {
        padding: 24px;
        spacing: 20px;
        alignment: start;

        // Header
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Multipoint & Bluetooth Devices";
                    color: Theme.text_primary;
                    font-size: 22px;
                    font-weight: 700;
                }

                Text {
                    text: "Manage active Bluetooth audio routing and paired headphones across your workstations";
                    color: Theme.text_secondary;
                    font-size: 13px;
                }
            }

            Rectangle {
                border-radius: Theme.radius_md;
                background: Theme.bg_card;
                border-width: 1px;
                border-color: Theme.border;
                height: 36px;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;

                    Image {
                        source: @image-url("../../assets/icons/refresh.svg");
                        width: 14px;
                        height: 14px;
                        colorize: Theme.text_primary;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Refresh";
                        color: Theme.text_primary;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => {
                        root.refresh_devices();
                    }
                }
            }
        }

        // Section: Devices List
        VerticalLayout {
            spacing: 12px;

            Text {
                text: "PAIRED HEADPHONES INVENTORY";
                color: Theme.text_muted;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
            }

            if root.devices.length == 0 : Rectangle {
                background: Theme.bg_card;
                border-radius: Theme.radius_md;
                border-width: 1px;
                border-color: Theme.border;
                height: 100px;

                Text {
                    text: "No paired AirPods or Bowers & Wilkins headphones detected in BlueZ.";
                    color: Theme.text_muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            for dev in root.devices : Rectangle {
                background: Theme.bg_card;
                border-radius: Theme.radius_md;
                border-width: 1px;
                border-color: dev.connected ? Theme.accent : Theme.border;
                height: 72px;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 16px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 14px;
                        alignment: start;

                        Rectangle {
                            width: 40px;
                            height: 40px;
                            border-radius: Theme.radius_sm;
                            background: dev.connected ? Theme.accent_subtle : Theme.bg_input;

                            Image {
                                source: @image-url("../../assets/icons/headphone.svg");
                                width: 20px;
                                height: 20px;
                                colorize: dev.connected ? Theme.accent_hover : Theme.text_muted;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: dev.name;
                                    color: Theme.text_primary;
                                    font-size: 14px;
                                    font-weight: 600;
                                }

                                if dev.connected : Rectangle {
                                    border-radius: Theme.radius_pill;
                                    background: #b8bb2622;
                                    height: 18px;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;

                                        Text {
                                            text: "Active";
                                            color: Theme.success;
                                            font-size: 10px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: dev.address + " • " + dev.vendor;
                                color: Theme.text_muted;
                                font-size: 12px;
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: center;
                        spacing: 10px;

                        if !dev.connected : Rectangle {
                            border-radius: Theme.radius_md;
                            background: touch_connect.has_hover ? Theme.accent : Theme.accent_subtle;
                            border-width: 1px;
                            border-color: Theme.accent;
                            height: 36px;

                            animate background { duration: 150ms; }
                            animate border-color { duration: 150ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    text: "Connect";
                                    color: touch_connect.has_hover ? Theme.bg_darkest : Theme.accent;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            touch_connect := TouchArea {
                                clicked => {
                                    root.connect_device(dev.address);
                                }
                            }
                        }

                        if dev.connected : Rectangle {
                            border-radius: Theme.radius_md;
                            background: touch_dc.has_hover ? #fb493422 : Theme.bg_input;
                            border-width: 1px;
                            border-color: touch_dc.has_hover ? Theme.danger : Theme.border;
                            height: 36px;

                            animate background { duration: 150ms; }
                            animate border-color { duration: 150ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                Text {
                                    text: "Disconnect";
                                    color: touch_dc.has_hover ? Theme.danger : Theme.text_secondary;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            touch_dc := TouchArea {
                                clicked => {
                                    root.disconnect_device(dev.address);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
