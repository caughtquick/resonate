export global Theme {
    // Font settings
    in-out property <string> font_family: "JetBrainsMono Nerd Font";

    // Primary background layers (Warm neutral dark / Gruvbox soft charcoal)
    in-out property <color> bg_darkest: #161616;      // Hard dark background
    in-out property <color> bg_sidebar: #1d1c1a;      // Sidebar deep warm charcoal
    in-out property <color> bg_main: #242424;         // Main canvas soft charcoal
    in-out property <color> bg_card: #282828;         // Card container
    in-out property <color> bg_tile: #302f2d;         // Inner tile / well
    in-out property <color> bg_card_hover: #32302f;   // Card hovered
    in-out property <color> bg_card_active: #3c3836;  // Card pressed/active
    in-out property <color> bg_input: #1c1c1c;        // Input / inner wells
    in-out property <color> bg_pill: #3c3836;         // Pill badge background

    // Accent colors (Warm amber / orange / gold, NOT blue)
    in-out property <color> accent: #fabd2f;          // Warm Gold/Amber
    in-out property <color> accent_hover: #fbf1c7;    // Light Cream
    in-out property <color> accent_subtle: #fabd2f22; // 13% opacity amber
    in-out property <color> accent_orange: #fe8019;   // Warm Orange
    in-out property <color> accent_purple: #d3869b;   // Mauve / Purple (Bluetooth)
    in-out property <color> accent_aqua: #8ec07c;     // Aqua / Teal
    in-out property <color> accent_blue: #83a598;     // Muted Blue

    // Tile icon backgrounds (translucent)
    in-out property <color> icon_bg_amber: #fabd2f26;
    in-out property <color> icon_bg_green: #b8bb2626;
    in-out property <color> icon_bg_purple: #d3869b26;
    in-out property <color> icon_bg_aqua: #8ec07c26;
    in-out property <color> icon_bg_orange: #fe801926;
    in-out property <color> icon_bg_neutral: #50494540;

    // Status colors
    in-out property <color> success: #b8bb26;         // Gruvbox Green (Charging / Connected)
    in-out property <color> warning: #fabd2f;         // Gruvbox Yellow/Amber
    in-out property <color> danger: #fb4934;          // Gruvbox Red
    in-out property <color> info: #8ec07c;            // Gruvbox Aqua

    // Typography & Text (Warm off-white & grays)
    in-out property <color> text_primary: #ebdbb2;    // Light Cream
    in-out property <color> text_secondary: #bdae93;  // Warm Gray
    in-out property <color> text_muted: #7c6f64;      // Muted Gray
    in-out property <color> text_disabled: #504945;   // Disabled

    // Borders & Dividers
    in-out property <color> border: #3a3836;          // Subtle card border
    in-out property <color> border_light: #504945;    // Highlight border

    // Standard border radii
    out property <length> radius_sm: 6px;
    out property <length> radius_md: 10px;
    out property <length> radius_lg: 14px;
    out property <length> radius_pill: 9999px;
}
