export global Theme {
    // Primary background layers
    out property <color> bg_darkest: #0f1117;
    out property <color> bg_sidebar: #131620;
    out property <color> bg_main: #181c27;
    out property <color> bg_card: #1f2433;
    out property <color> bg_card_hover: #262c3e;
    out property <color> bg_card_active: #2e354b;
    out property <color> bg_input: #151822;

    // Accent colors
    out property <color> accent: #3b82f6;          // Blue
    out property <color> accent_hover: #60a5fa;
    out property <color> accent_subtle: #1e3a8a33;
    out property <color> accent_purple: #8b5cf6;
    out property <color> accent_teal: #14b8a6;

    // Status colors
    out property <color> success: #10b981;         // Green (Charging / Connected)
    out property <color> warning: #f59e0b;         // Orange (Medium battery / Disconnected)
    out property <color> danger: #ef4444;          // Red (Low battery / Error)
    out property <color> info: #06b6d4;            // Cyan (Adaptive)

    // Typography & Text
    out property <color> text_primary: #f8fafc;
    out property <color> text_secondary: #94a3b8;
    out property <color> text_muted: #64748b;
    out property <color> text_disabled: #475569;

    // Borders & Dividers
    out property <color> border: #283046;
    out property <color> border_light: #333d59;

    // Standard border radii
    out property <length> radius_sm: 6px;
    out property <length> radius_md: 10px;
    out property <length> radius_lg: 16px;
    out property <length> radius_pill: 9999px;
}
